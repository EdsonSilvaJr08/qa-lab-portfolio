{
  "name": "qa-lab-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PulseDesk: aplicação demonstrativa para estudo de QA manual, E2E e CI.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run test && npm run test:e2e"
  },
  "devDependencies": { "@playwright/test": "1.55.1" },
  "engines": { "node": ">=20" }
}
